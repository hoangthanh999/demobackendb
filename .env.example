# =====================
# Database Configuration
# =====================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/badminton_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_password_here

# =====================
# JWT Configuration
# =====================
# IMPORTANT: Must be at least 64 characters (512 bits) for HS512
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_long_for_hs512_algorithm_security

# =====================
# MoMo Payment Configuration
# =====================
MOMO_PARTNER_CODE=MOMOXXX
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# =====================
# Cloudinary Configuration
# =====================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =====================
# Mailjet Email Configuration
# =====================
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=noreply@yourdomain.com

# =====================
# OpenAI Configuration (Optional)
# =====================
OPENAI_API_KEY=sk-your_openai_api_key_here

# =====================
# Application URLs
# =====================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080/api

# =====================
# Payment Configuration
# =====================
DEPOSIT_PERCENTAGE=30
PAYMENT_MOCK_ENABLED=true

# =====================
# Server Port (Optional)
# =====================
PORT=8080
